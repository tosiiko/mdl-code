page@id(examplesPage):
  topbar@class(site-topbar):
    brand:
      .href@href(/)@class(site-brand)(MDL)
    nav@class(site-nav)@aria-label(Primary):
      .href@href(/docs)(Docs)
      .href@href(/cli)(CLI)
      .href@href(/examples)@class(is-active)(Examples)
      .href@href(/pricing)(Pricing)
      .href@href(/contact)@class(nav-cta)(Contact)
  hero@class(page-hero examples-hero):
    .badge(Examples)
    # Complete sections, not placeholders
    This page collects common website patterns built with plain MDL sections and styled through the same CSS bundle.
  section@class(pattern-section):
    header:
      .badge(Patterns)
      ## Use these as page building blocks
    grid@class(pattern-grid):
      card:
        .tag(Navigation)
        ### Header and footer
        `topbar`, `brand`, `nav`, and `footer` sections create stable hooks for global layout.
      card:
        .tag(Content)
        ### Feature grids
        `grid` and repeated `card` sections make scanning, comparison, and reuse straightforward.
      card:
        .tag(Forms)
        ### Contact flows
        `form`, `field`, `label`, `.input`, and `textarea` can be wired to JavaScript with `@submit`.
      card:
        .tag(Interactions)
        ### Tabs and toasts
        `tabs`, `tablist`, `tab`, and `toast` keep stateful UI visible in the source.
  section@class(comparison-section):
    header:
      .badge(Comparison)
      ## MDL page pieces
    table:
      thead:
        tr:
          th:
            Pattern
          th:
            MDL source
          th:
            HTML result
      tbody:
        tr:
          td:
            Hero
          td:
            `hero:`
          td:
            `.mdl-hero`
        tr:
          td:
            Card grid
          td:
            `grid:` plus `card:`
          td:
            `.mdl-grid` and `.mdl-card`
        tr:
          td:
            Form
          td:
            `form@submit(handler):`
          td:
            Semantic form with event binding
  section@class(sample-section):
    header:
      .badge(Starter set)
      ## Three page recipes
    grid@class(recipe-grid):
      article:
        ## Product site
        Hero, metrics, feature grid, proof section, pricing, and contact.
        actions:
          .href@href(/pricing)@class(btn-link secondary)(View pricing)
      article:
        ## Documentation hub
        Page hero, sidebar, tabbed guide, details blocks, and a footer CTA.
        actions:
          .href@href(/docs)@class(btn-link secondary)(Read docs)
      article:
        ## Lead capture
        Form fields, validation copy, submit handler, toast, and success state.
        actions:
          .href@href(/contact)@class(btn-link secondary)(Open contact)
  toast@id(siteToast)@aria-live(polite):
    The example interaction is ready.
  footer@class(site-footer):
    brand:
      .href@href(/)@class(site-brand)(MDL)
      Examples page authored in MDL.
    nav@aria-label(Footer):
      .href@href(/)(Home)
      .href@href(/docs)(Docs)
      .href@href(/cli)(CLI)
      .href@href(/pricing)(Pricing)
      .href@href(/contact)(Contact)
