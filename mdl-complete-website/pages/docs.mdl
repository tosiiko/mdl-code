page@id(docsPage):
  topbar@class(site-topbar):
    brand:
      .href@href(/)@class(site-brand)(MDL)
    nav@class(site-nav)@aria-label(Primary):
      .href@href(/docs)@class(is-active)(Docs)
      .href@href(/cli)(CLI)
      .href@href(/examples)(Examples)
      .href@href(/pricing)(Pricing)
      .href@href(/contact)@class(nav-cta)(Contact)
  hero@class(page-hero docs-hero):
    .badge(Docs)
    # Build with MDL
    The core language is small: sections create structure, Markdown creates content, dot elements create controls, and attributes add detail.
  section@class(docs-layout):
    sidebar@class(docs-sidebar):
      ## Contents
      list:
        item:
          .href@href(#basics)(Basics)
        item:
          .href@href(#projects)(Projects)
        item:
          .href@href(#deploy)(Build)
    article@class(docs-content):
      tabs@id(docsTabs)@class(docs-tabs):
        tablist@role(tablist)@aria-label(Documentation sections):
          .btn-secondary@type(button)@id(tabBasicsButton)@click(showDocsBasics)(Basics)
          .btn-ghost@type(button)@id(tabProjectsButton)@click(showDocsProjects)(Projects)
          .btn-ghost@type(button)@id(tabDeployButton)@click(showDocsDeploy)(Build)
        tab@id(tabBasics)@data-state(active)@role(tabpanel):
          section@id(basics):
            ## Basics
            MDL uses indentation to nest sections. A `hero` section becomes a `.mdl-hero` element, and a `card` section becomes a `.mdl-card` element.
            grid@class(doc-card-grid):
              card:
                ### Sections
                Use names like `page`, `topbar`, `nav`, `grid`, `card`, `form`, `details`, and `footer`.
              card:
                ### Inline elements
                Use dot elements such as `.badge(beta)`, `.href@href(/docs)(Docs)`, and `.input@type(email)`.
              card:
                ### Attributes
                Add explicit attributes with `@id(value)`, `@class(value)`, `@required`, or `@submit(handlerName)`.
        tab@id(tabProjects)@role(tabpanel):
          section@id(projects):
            ## Project layout
            A complete MDL website is just a folder with pages, CSS, optional scripts, and `mdl.json`.
            steps:
              step:
                ### Configure
                Set `pages`, `output`, `styles`, `scripts`, title, and local preview port in `mdl.json`.
              step:
                ### Author pages
                Put each `.mdl` page under the configured `pages` folder. Nested folders become nested routes.
              step:
                ### Keep assets nearby
                Store images under `assets` and reference them from CSS or page content.
        tab@id(tabDeploy)@role(tabpanel):
          section@id(deploy):
            ## Build and preview
            Run `../../bin/mdl serve` inside this project for live preview, or `../../bin/mdl build` to compile static output into `dist`.
            details@open:
              summary:
                What gets generated?
              The build creates one HTML file for each MDL page and writes a bundled stylesheet at `dist/app.css`.
            details:
              summary:
                How do scripts bind?
              Event attributes such as `@click(showDocsBasics)` are compiled into data attributes. The generated runtime imports `scripts/site.js` and calls exported functions by name.
  banner@class(site-banner compact):
    ## Want to see the components in context?
    Browse the examples page for repeated cards, comparison layouts, and a contact workflow.
    actions:
      .href@href(/examples)@class(btn-link primary)(View examples)
  footer@class(site-footer):
    brand:
      .href@href(/)@class(site-brand)(MDL)
      Documentation page authored in MDL.
    nav@aria-label(Footer):
      .href@href(/)(Home)
      .href@href(/cli)(CLI)
      .href@href(/examples)(Examples)
      .href@href(/pricing)(Pricing)
      .href@href(/contact)(Contact)
