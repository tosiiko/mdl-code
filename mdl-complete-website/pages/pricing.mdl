page@id(pricingPage):
  topbar@class(site-topbar):
    brand:
      .href@href(/)@class(site-brand)(MDL)
    nav@class(site-nav)@aria-label(Primary):
      .href@href(/docs)(Docs)
      .href@href(/cli)(CLI)
      .href@href(/examples)(Examples)
      .href@href(/pricing)@class(is-active)(Pricing)
      .href@href(/contact)@class(nav-cta)(Contact)
  hero@class(page-hero pricing-hero):
    .badge(Pricing)
    # Pick a launch shape
    MDL is tiny enough for prototypes and steady enough for complete static sites. These plans model how a product site could present offers.
  pricing@class(pricing-grid):
    card:
      .tag(Starter)
      ## Launch
      $0 for local projects
      list:
        item:
          Multi-page MDL authoring
        item:
          CSS runtime and bundle
        item:
          Local preview server
      actions:
        .btn-primary@type(button)@click(showPlan)(Choose Launch)
    card@class(featured-plan):
      .tag(Recommended)
      ## Studio
      $19 per seat
      list:
        item:
          Everything in Launch
        item:
          Team conventions and snippets
        item:
          Review-ready static exports
      actions:
        .btn-primary@type(button)@click(showPlan)(Choose Studio)
    card:
      .tag(Scale)
      ## Platform
      Custom
      list:
        item:
          Shared design systems
        item:
          Project templates
        item:
          Publishing support
      actions:
        .btn-primary@type(button)@click(showPlan)(Talk to sales)
  section@class(faq-section):
    header:
      .badge(FAQ)
      ## Questions teams ask
    grid@class(faq-grid):
      details@open:
        summary:
          Is this website really authored in MDL?
        Yes. Every page in this example is an `.mdl` file, with CSS and JavaScript loaded through `mdl.json`.
      details:
        summary:
          Can I use normal CSS?
        Yes. MDL emits stable classes and lets CSS own the layout, theme, responsive behavior, and polish.
      details:
        summary:
          Does MDL replace JavaScript?
        No. It keeps JavaScript explicit. Add event attributes in MDL and export the matching handler functions.
  toast@id(siteToast)@aria-live(polite):
    Plan selected.
  footer@class(site-footer):
    brand:
      .href@href(/)@class(site-brand)(MDL)
      Pricing page authored in MDL.
    nav@aria-label(Footer):
      .href@href(/)(Home)
      .href@href(/docs)(Docs)
      .href@href(/cli)(CLI)
      .href@href(/examples)(Examples)
      .href@href(/contact)(Contact)
