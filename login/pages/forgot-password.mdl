page@id(forgotPage):
  hero:
    ## Reset password
    Test a popup message without leaving the local MDL preview.

  form@id(resetForm)@submit(handleResetPassword):
    field@id(resetEmailField):
      label:
        Email address
      .input@type(email)@id(resetEmailInput)@required@placeholder(demo@mdl.local)

    error@id(resetMsg)@aria-live(polite):
      Enter an email and MDL will show a reset confirmation popup.

    actions:
      .btn-primary@id(resetBtn)(Send reset link)
      .btn-ghost@type(button)@click(goToLogin)(Back to sign in)

  popup@id(appPopup)@aria-live(polite):
    panel:
      popup-title@id(popupTitle):
        Message
      popup-message@id(popupMessage):
        Waiting.
      actions:
        .btn-secondary@type(button)@id(popupCloseBtn)@click(closePopup)(OK)
